<?xml version="1.0"?>
<!--
  picar_tracking.urdf
  URDF for live RViz visualization anchored to the 'camera' TF frame
  published by tf_bridge. All joints are fixed — no joint states needed.

  Coordinate convention (OpenCV/pupil-apriltags camera frame):
    +Z = optical axis (forward, toward tags)
    +X = image right
    +Y = image down

  Offsets from 'camera' to 'base_link' approximate the PiCar-X geometry
  (camera ~8 cm above chassis center, ~5 cm forward of body center).
  Tune the joint origin after visual inspection in RViz.
-->
<robot name="picar_tracking">

  <material name="picar_white">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>
  <material name="picar_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="picar_gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="picar_blue">
    <color rgba="0.2 0.4 0.85 0.85"/>
  </material>

  <!-- ROOT: camera optical frame (matches tf_bridge 'camera' TF) -->
  <link name="camera">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.02"/>
      </geometry>
      <material name="picar_blue"/>
    </visual>
  </link>

  <!-- Camera pan/tilt mount column -->
  <link name="camera_mount">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.07 0.03"/>
      </geometry>
      <material name="picar_gray"/>
    </visual>
  </link>
  <joint name="camera_to_mount" type="fixed">
    <parent link="camera"/>
    <child link="camera_mount"/>
    <!-- column is below (+Y=down) and slightly behind (-Z) the camera lens -->
    <origin xyz="0.0 0.045 -0.01" rpy="0 0 0"/>
  </joint>

  <!-- Car chassis -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- X=width(0.14m), Y=height(0.04m), Z=length(0.20m) in camera frame -->
        <box size="0.14 0.04 0.20"/>
      </geometry>
      <material name="picar_white"/>
    </visual>
  </link>
  <joint name="mount_to_chassis" type="fixed">
    <parent link="camera_mount"/>
    <child link="base_link"/>
    <!-- chassis center is below the mount and centered along optical axis -->
    <origin xyz="0.0 0.05 -0.04" rpy="0 0 0"/>
  </joint>

  <!-- Front left wheel -->
  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.033"/>
      </geometry>
      <material name="picar_black"/>
    </visual>
  </link>
  <joint name="chassis_to_fl_wheel" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="-0.07 0.02 0.07" rpy="0 0 0"/>
  </joint>

  <!-- Front right wheel -->
  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.033"/>
      </geometry>
      <material name="picar_black"/>
    </visual>
  </link>
  <joint name="chassis_to_fr_wheel" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.07 0.02 0.07" rpy="0 0 0"/>
  </joint>

  <!-- Rear left wheel -->
  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.033"/>
      </geometry>
      <material name="picar_black"/>
    </visual>
  </link>
  <joint name="chassis_to_rl_wheel" type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.07 0.02 -0.07" rpy="0 0 0"/>
  </joint>

  <!-- Rear right wheel -->
  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.033"/>
      </geometry>
      <material name="picar_black"/>
    </visual>
  </link>
  <joint name="chassis_to_rr_wheel" type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="0.07 0.02 -0.07" rpy="0 0 0"/>
  </joint>

</robot>
